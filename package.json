{
  "name": "@prastya-dev/jack-agent",
  "version": "1.1.9",
  "description": "JACK-AGENT: AI CLI Terminal Interface by prastya-dev, powered by Google Antigravity",
  "main": "dist/index.js",
  "files": [
    "dist",
    "jack.ico",
    "icon.png"
  ],
  "bin": {
    "jack": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist binaries",
    "pkg:linux": "pkg dist/index.js --targets node18-linux-x64 --output binaries/jack-linux-x64 --compress GZip",
    "pkg:macos": "pkg dist/index.js --targets node18-macos-x64 --output binaries/jack-macos-x64 --compress GZip",
    "pkg:win": "pkg dist/index.js --targets node18-win-x64 --output binaries/jack-win-x64.exe --compress GZip",
    "pkg:all": "npm run build && npm run pkg:linux && npm run pkg:macos && npm run pkg:win"
  },
  "keywords": [
    "ai",
    "cli",
    "terminal",
    "gemini",
    "jack",
    "tui"
  ],
  "author": "prastya-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prastya-dev/jack_agent.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "open": "8.4.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "@yao-pkg/pkg": "^5.11.5"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [],
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "binaries"
  }
}
